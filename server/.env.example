# Copy to .env and fill in for LIVE transcription. Demo mode needs nothing.
# SECURITY: this key lives ONLY on the server now (that's the point of the backend).
# Set a hard spending cap on it and delete/rotate it after the hackathon.
OPENAI_API_KEY=

# Port the API listens on (Replit sets PORT automatically).
PORT=8787

# Comma-separated allowed CORS origins. "*" for demo. Set to your Replit
# frontend URL for anything real.
CORS_ORIGIN=*
