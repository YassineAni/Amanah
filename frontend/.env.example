# Where the backend API is. Change for deploy.
VITE_API_BASE=http://localhost:8787

# Supabase project — auth only (magic-link sign-in). The anon key is safe to
# ship in a frontend build; it has no privileges beyond what RLS grants the
# authenticated role, and every data call still goes through the API above,
# never Supabase directly.
VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
